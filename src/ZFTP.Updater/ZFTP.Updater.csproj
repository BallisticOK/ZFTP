<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Small standalone updater. WinExe = no console window; WinForms = message boxes. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- See ZFTP.App.csproj: pins native-asset selection to Windows so packages
         that ship binaries for every OS don't copy macOS/Linux ones in too. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>ZFTP.Updater</AssemblyName>
    <ApplicationIcon>..\ZFTP.App\zftp.ico</ApplicationIcon>
    <Version>2.7.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZFTP.Core\ZFTP.Core.csproj" />
  </ItemGroup>

</Project>
