<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Enables the System.Windows.Forms NotifyIcon used for the system tray. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Ship the app as ZFTP.exe (cleaner than ZFTP.App.exe). -->
    <AssemblyName>ZFTP</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- Pins asset selection to Windows so NuGet packages that ship native
         binaries for every OS (like iMobileDevice-net) only ever copy the
         win-x64 ones into our output - without this, a plain `dotnet build`
         has no RID to select by and copies ALL of them, including macOS/Linux
         binaries this Windows-only app can never load. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>zftp.ico</ApplicationIcon>
    <Company>ZFTP</Company>
    <Product>ZFTP</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZFTP.Core\ZFTP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App logo shown in the title bar / window icon. -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled rclone engine (powers FTP/FTPS/WebDAV/S3/cloud providers). -->
    <None Include="tools\rclone.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rclone.exe</Link>
    </None>
    <!-- Bundled adb engine (powers the Android-over-USB provider). adb.exe needs
         its two USB helper DLLs sitting next to it to talk to devices. -->
    <None Include="tools\adb.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\adb.exe</Link>
    </None>
    <None Include="tools\AdbWinApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\AdbWinApi.dll</Link>
    </None>
    <None Include="tools\AdbWinUsbApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\AdbWinUsbApi.dll</Link>
    </None>
  </ItemGroup>

  <!-- iMobileDevice-net bundles the FULL libimobiledevice command-line toolset,
       including device-recovery/DFU-mode tools (idevicerestore, irecovery) that
       ZFTP never uses - our Apple support only does AFC file access (Photos /
       File Sharing apps), never device restore. These specific tools are also
       what trips antivirus heuristics (their whole job is talking to a phone's
       bootloader, the same thing jailbreak/exploit tools do), so drop them from
       the shipped app rather than carry files we don't need and that just
       generate false-positive scares for users and contributors. -->
  <Target Name="RemoveUnusedRecoveryTools" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)%(Extension)' == 'idevicerestore.exe'
                or '%(Filename)%(Extension)' == 'ideviceenterrecovery.exe'
                or '%(Filename)%(Extension)' == 'irecovery.exe'
                or '%(Filename)%(Extension)' == 'irecovery.dll'" />
    </ItemGroup>
  </Target>

</Project>
