<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net8.0-windows carries the native WinFsp/AFC mount engines (see
         ZFTP.Core.csproj); plain net8.0 is the portable Avalonia build used on
         Linux/macOS. See App.axaml.cs/EditDriveWindow.axaml.cs's #if WINDOWS
         blocks for where the two diverge. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ship the app as ZFTP.exe (cleaner than ZFTP.App.exe). -->
    <AssemblyName>ZFTP</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <DefineConstants Condition="'$(TargetFramework)'=='net8.0-windows'">$(DefineConstants);WINDOWS</DefineConstants>
    <Version>2.6.1</Version>
    <FileVersion>2.6.1.0</FileVersion>
    <AssemblyVersion>2.6.1.0</AssemblyVersion>
    <Company>ZFTP</Company>
    <Product>ZFTP</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>zftp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.18" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)'=='Debug'" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.3.0" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="1.1.278" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZFTP.Core\ZFTP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App logo shown in the title bar / window icon. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Bundled rclone/adb engines - Windows-only for now (no Linux/macOS binaries
       are bundled yet; RcloneService/AdbService fall back to PATH there - see
       ToolResolver.cs in ZFTP.Core). -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <None Include="tools\rclone.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\rclone.exe</Link>
    </None>
    <None Include="tools\adb.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\adb.exe</Link>
    </None>
    <None Include="tools\AdbWinApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\AdbWinApi.dll</Link>
    </None>
    <None Include="tools\AdbWinUsbApi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools\AdbWinUsbApi.dll</Link>
    </None>
  </ItemGroup>

  <!-- iMobileDevice-net bundles the FULL libimobiledevice command-line toolset,
       including device-recovery/DFU-mode tools (idevicerestore, irecovery) that
       ZFTP never uses - our Apple support only does AFC file access (Photos /
       File Sharing apps), never device restore. These specific tools are also
       what trips antivirus heuristics (their whole job is talking to a phone's
       bootloader, the same thing jailbreak/exploit tools do), so drop them from
       the shipped app rather than carry files we don't need and that just
       generate false-positive scares for users and contributors. Only relevant
       on Windows - iMobileDevice-net is only referenced there (see ZFTP.Core). -->
  <Target Name="RemoveUnusedRecoveryTools" AfterTargets="ResolveReferences" Condition="'$(TargetFramework)'=='net8.0-windows'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(Filename)%(Extension)' == 'idevicerestore.exe'
                or '%(Filename)%(Extension)' == 'ideviceenterrecovery.exe'
                or '%(Filename)%(Extension)' == 'irecovery.exe'
                or '%(Filename)%(Extension)' == 'irecovery.dll'" />
    </ItemGroup>
  </Target>

</Project>
