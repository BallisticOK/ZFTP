<Window x:Class="ZFTP.App.EditDriveWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:FluentIcons.Avalonia.Fluent"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        Title="Edit drive" Height="700" Width="540"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,8,22,8">
            <StackPanel>
                <TextBlock Text="Type" Margin="0,0,0,4" />
                <ComboBox x:Name="TypeCombo" Margin="0,0,0,14" SelectionChanged="TypeCombo_SelectionChanged" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="SFTP" />
                    <ComboBoxItem Content="FTP" />
                    <ComboBoxItem Content="FTP over TLS (FTPS)" />
                    <ComboBoxItem Content="WebDAV" />
                    <ComboBoxItem Content="Amazon S3 / compatible" />
                    <ComboBoxItem Content="Google Drive" />
                    <ComboBoxItem Content="Dropbox" />
                    <ComboBoxItem Content="OneDrive" />
                    <ComboBoxItem Content="Box" />
                    <ComboBoxItem Content="SMB / Windows network share" />
                    <ComboBoxItem Content="Backblaze B2" />
                    <ComboBoxItem Content="Microsoft Azure Blob Storage" />
                    <ComboBoxItem Content="Mega.nz" />
                    <ComboBoxItem Content="Proton Drive" />
                    <ComboBoxItem Content="Android device (USB)" />
                    <ComboBoxItem Content="iPhone / iPad (USB) - limited" />
                </ComboBox>

                <TextBlock Text="Display name" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Watermark="My Server" Margin="0,0,0,14" />

                <!-- Host + Port (SFTP / FTP / FTPS / SMB) -->
                <StackPanel x:Name="HostPanel">
                    <Grid Margin="0,0,0,14" ColumnDefinitions="*,110">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Host" Margin="0,0,0,4" />
                            <TextBox x:Name="HostBox" Watermark="Host IP" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Port" Margin="0,0,0,4" />
                            <TextBox x:Name="PortBox" Text="22" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- WebDAV URL -->
                <StackPanel x:Name="UrlPanel" IsVisible="False">
                    <TextBlock Text="Server URL" Margin="0,0,0,4" />
                    <TextBox x:Name="UrlBox" Watermark="https://dav.example.com/remote.php/webdav" Margin="0,0,0,14" />
                </StackPanel>

                <!-- Username (SFTP/FTP/FTPS/WebDAV/SMB/Mega/Proton) -->
                <StackPanel x:Name="UserPanel">
                    <TextBlock Text="Username" Margin="0,0,0,4" />
                    <TextBox x:Name="UserBox" Watermark="Username" Margin="0,0,0,14" />
                </StackPanel>

                <!-- Auth method (SFTP only) -->
                <StackPanel x:Name="AuthPanel">
                    <TextBlock Text="Authentication" Margin="0,0,0,4" />
                    <ComboBox x:Name="AuthCombo" Margin="0,0,0,14" SelectionChanged="AuthCombo_SelectionChanged" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Password" IsSelected="True" />
                        <ComboBoxItem Content="SSH private key" />
                    </ComboBox>
                    <CheckBox x:Name="ForgetHostKeyCheck" Margin="0,0,0,14"
                              Content="Forget saved server key (re-trust on next connect)" />
                </StackPanel>

                <!-- Password (SFTP/FTP/FTPS/WebDAV/SMB/Mega/Proton) -->
                <StackPanel x:Name="PasswordPanel">
                    <TextBlock Text="Password" Margin="0,0,0,4" />
                    <TextBox x:Name="PasswordBox" PasswordChar="●" Margin="0,0,0,14" />
                </StackPanel>

                <!-- SSH key (SFTP only) -->
                <StackPanel x:Name="KeyPanel" IsVisible="False">
                    <TextBlock Text="Private key file" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                        <TextBox x:Name="KeyPathBox" Grid.Column="0" Watermark="/home/you/.ssh/id_rsa" />
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>
                    <TextBlock Text="Key passphrase (if any)" Margin="0,0,0,4" />
                    <TextBox x:Name="KeyPassBox" PasswordChar="●" Margin="0,0,0,14" />
                </StackPanel>

                <!-- S3 -->
                <StackPanel x:Name="S3Panel" IsVisible="False">
                    <TextBlock Text="Access Key ID" Margin="0,0,0,4" />
                    <TextBox x:Name="S3KeyBox" Margin="0,0,0,14" />
                    <TextBlock Text="Secret Access Key" Margin="0,0,0,4" />
                    <TextBox x:Name="S3SecretBox" PasswordChar="●" Margin="0,0,0,14" />
                    <TextBlock Text="Bucket" Margin="0,0,0,4" />
                    <TextBox x:Name="S3BucketBox" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,14" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Region (optional)" Margin="0,0,0,4" />
                            <TextBox x:Name="S3RegionBox" Watermark="us-east-1" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Endpoint (blank = AWS)" Margin="0,0,0,4" />
                            <TextBox x:Name="S3EndpointBox" Watermark="s3.wasabisys.com" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- SMB share + domain -->
                <StackPanel x:Name="SmbPanel" IsVisible="False">
                    <TextBlock Text="Share name" Margin="0,0,0,4" />
                    <TextBox x:Name="SmbShareBox" Watermark="Public" Margin="0,0,0,14" />
                    <TextBlock Text="Domain / workgroup (optional)" Margin="0,0,0,4" />
                    <TextBox x:Name="SmbDomainBox" Margin="0,0,0,14" />
                </StackPanel>

                <!-- Backblaze B2 -->
                <StackPanel x:Name="B2Panel" IsVisible="False">
                    <TextBlock Text="Application Key ID" Margin="0,0,0,4" />
                    <TextBox x:Name="B2AccountBox" Margin="0,0,0,14" />
                    <TextBlock Text="Application Key" Margin="0,0,0,4" />
                    <TextBox x:Name="B2KeyBox" PasswordChar="●" Margin="0,0,0,14" />
                    <TextBlock Text="Bucket" Margin="0,0,0,4" />
                    <TextBox x:Name="B2BucketBox" Margin="0,0,0,14" />
                </StackPanel>

                <!-- Microsoft Azure Blob Storage -->
                <StackPanel x:Name="AzurePanel" IsVisible="False">
                    <TextBlock Text="Storage account name" Margin="0,0,0,4" />
                    <TextBox x:Name="AzureAccountBox" Margin="0,0,0,14" />
                    <TextBlock Text="Account key" Margin="0,0,0,4" />
                    <TextBox x:Name="AzureKeyBox" PasswordChar="●" Margin="0,0,0,14" />
                    <TextBlock Text="Container" Margin="0,0,0,4" />
                    <TextBox x:Name="AzureContainerBox" Margin="0,0,0,14" />
                </StackPanel>

                <!-- Proton Drive -->
                <StackPanel x:Name="ProtonPanel" IsVisible="False">
                    <TextBlock Text="2FA code (only needed once, if enabled)" Margin="0,0,0,4" />
                    <TextBox x:Name="ProtonTwoFactorBox" Watermark="123456" Margin="0,0,0,14" />
                    <TextBlock Text="Mailbox password (only for two-password accounts)" Margin="0,0,0,4" />
                    <TextBox x:Name="ProtonMailboxPasswordBox" PasswordChar="●" Margin="0,0,0,14" />
                </StackPanel>

                <!-- OAuth cloud drives -->
                <StackPanel x:Name="OAuthPanel" IsVisible="False">
                    <Border Classes="card" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="OAuthStatusText" Text="Not signed in." FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Click below — your browser opens so you can sign into your account. ZFTP never sees your password. You only do this once; it's remembered."
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button x:Name="SignInButton" Click="SignIn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:SymbolIcon Symbol="Globe" FontSize="16" />
                                    <TextBlock Text="Sign in with browser" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- OneDrive only: Microsoft can offer more than one "drive" for a
                         single account (including hidden system ones) - shown once sign-in
                         finds them, so the user picks the real one instead of it guessing. -->
                    <Border x:Name="OnedriveDriveCard" Classes="card" Padding="14" Margin="0,0,0,10" IsVisible="False">
                        <StackPanel>
                            <TextBlock Text="Which OneDrive is this?" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Microsoft accounts can have more than one of these, including hidden system ones. If you're not sure, the plain 'OneDrive' entry is usually right." />
                            <ComboBox x:Name="OnedriveDriveCombo" Margin="0,0,0,10" HorizontalAlignment="Stretch" />
                            <Button x:Name="OnedriveChooseButton" Classes="accent" Content="Use this drive" Click="OnedriveChoose_Click" />
                        </StackPanel>
                    </Border>

                    <Expander Header="Advanced — own app credentials (optional)" Margin="0,0,0,14">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10"
                                       Text="Leave blank to use the built-in sign-in. If the cloud keeps asking you to log back in, paste your own free Client ID &amp; Secret here for a permanent connection (see the provider's developer console)." />
                            <TextBlock Text="Client ID" Margin="0,0,0,4" />
                            <TextBox x:Name="ClientIdBox" Margin="0,0,0,10" />
                            <TextBlock Text="Client Secret" Margin="0,0,0,4" />
                            <TextBox x:Name="ClientSecretBox" PasswordChar="●" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- Android device (USB / adb) -->
                <StackPanel x:Name="AndroidPanel" IsVisible="False">
                    <Border Classes="card" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Connect your phone or tablet over USB, then enable USB debugging:"
                                       FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Text="Settings - About phone - tap Build number 7 times to unlock Developer options, then Settings - System - Developer options - turn on USB debugging. Plug in the cable and tap Allow on the phone." />
                            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                       Text="No app is installed on the phone and root is not required. The drive shows your shared storage (default /sdcard)." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Device" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto">
                        <ComboBox x:Name="DeviceCombo" Grid.Column="0" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" x:Name="RefreshDevicesButton" Content="Refresh"
                                Margin="8,0,0,0" Click="RefreshDevices_Click" />
                    </Grid>
                </StackPanel>

                <!-- iPhone / iPad (Apple AFC over USB) -->
                <StackPanel x:Name="ApplePanel" IsVisible="False">
                    <ui:InfoBar x:Name="AppleLimitBar" Severity="Warning" IsOpen="True" IsClosable="False"
                                Title="Limited: photos and File-Sharing apps only" Margin="0,0,0,10"
                                Message="Apple locks iOS down, so this shows your Photos/DCIM and the file folders of apps that allow File Sharing - NOT the whole phone. Full storage isn't possible without a jailbreak." />
                    <Border Classes="card" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Before connecting:" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                                       Text="Install Apple Devices (or iTunes) once so Windows has the iPhone USB driver. Plug in the device, unlock it, and tap Trust This Computer when asked." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Device" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto">
                        <ComboBox x:Name="AppleDeviceCombo" Grid.Column="0" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" x:Name="RefreshAppleButton" Content="Refresh"
                                Margin="8,0,0,0" Click="RefreshAppleDevices_Click" />
                    </Grid>
                </StackPanel>

                <!-- Remote folder + drive / mount path -->
                <Grid Margin="0,0,0,14" ColumnDefinitions="*,160">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Remote folder" Margin="0,0,0,4" />
                        <TextBox x:Name="RootBox" Watermark="/  (root)" Text="/" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="DriveFieldLabel" Text="Drive" Margin="0,0,0,4" />
                        <ComboBox x:Name="DriveCombo" HorizontalAlignment="Stretch" />
                        <TextBox x:Name="MountPathBox" Watermark="(auto)" IsVisible="False" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14" ColumnDefinitions="*,150">
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Permissions" Margin="0,0,0,4" />
                        <ComboBox x:Name="AccessCombo" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Read &amp; Write" IsSelected="True" />
                            <ComboBoxItem Content="Read only" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Colour" Margin="0,0,0,4" />
                        <ComboBox x:Name="ColorCombo" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <Border Classes="card" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Enabled" FontWeight="SemiBold" />
                                <TextBlock Text="Include this drive in Mount all." Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EnabledToggle" HorizontalAlignment="Right" IsChecked="True" />
                        </Grid>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Auto-mount on startup" FontWeight="SemiBold" />
                                <TextBlock Text="Mount this drive automatically when ZFTP starts." Opacity="0.7" FontSize="12" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoMountToggle" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,10,22,16" Spacing="10">
            <Button Content="Cancel" MinWidth="90" Click="Cancel_Click" />
            <Button Classes="accent" Content="Save" MinWidth="90" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
