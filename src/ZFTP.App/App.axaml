<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZFTP.App.App"
             xmlns:styling="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <!-- FluentAvaloniaTheme gives us the Windows 11 / Fluent look, including
             all of FluentAvaloniaUI's extra controls (Card-ish SettingsExpander,
             InfoBar, SymbolIcon, etc.) - a full replacement for WPF-UI's merged
             ThemesDictionary/ControlsDictionary. -->
        <styling:FluentAvaloniaTheme />

        <!-- WPF-UI's Card, as a plain styled Border - used by both windows. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Styles>
</Application>
