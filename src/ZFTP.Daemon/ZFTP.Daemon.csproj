<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless host for Linux/macOS (and Windows, for local dev without WinFsp):
       loads the same profiles/settings ZFTP.App does and drives ZFTP.Core's
       MountSession directly, with no WPF. See MountSession.cs's #if WINDOWS
       blocks - on non-Windows this only supports rclone-backed providers
       (SFTP included, via rclone's own sftp backend); Android/iPhone need
       Windows for now. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>zftpd</AssemblyName>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZFTP.Core\ZFTP.Core.csproj" />
  </ItemGroup>

</Project>
