<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows carries the native WinFsp/adb/AFC mount engines (drive-letter
         mounting on Windows); plain net8.0 is the portable slice used on Linux/macOS,
         where mounting instead goes through rclone. See MountSession.cs's #if WINDOWS
         blocks for where the two diverge. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <DefineConstants Condition="'$(TargetFramework)'=='net8.0-windows'">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Devlooped.CredentialManager" Version="2.7.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <!-- Windows-only: the native WinFsp mount engine (SFTP/Android/iPhone via
       Fsp.FileSystemHost) and its supporting libraries. Excluded entirely from the
       net8.0 (non-Windows) build - see MountSession.cs's #if WINDOWS blocks. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <PackageReference Include="iMobileDevice-net" Version="1.3.17" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <Reference Include="winfsp-msil">
      <HintPath>C:\Program Files (x86)\WinFsp\bin\winfsp-msil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net8.0-windows'">
    <Compile Remove="WinFspNative.cs" />
    <Compile Remove="SftpFileSystem.cs" />
    <Compile Remove="AdbFileSystem.cs" />
    <Compile Remove="AfcFileSystem.cs" />
    <!-- Uses iMobileDevice-net types directly (iDeviceHandle/LockdownClientHandle);
         that package only ships Windows native binaries, so iPhone/iPad device
         discovery - like the AFC mount engine itself - stays Windows-only for now. -->
    <Compile Remove="AppleDeviceService.cs" />
  </ItemGroup>

</Project>
