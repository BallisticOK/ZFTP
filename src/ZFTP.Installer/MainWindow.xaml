<Window x:Class="ZFTP.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZFTP Setup"
        Width="940" Height="590" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#0E1117" AllowsTransparency="False">
    <Border Background="#0E1117" BorderBrush="#303844" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Branded rail -->
            <Border Grid.Column="0" Background="#111722" BorderBrush="#26303D" BorderThickness="0,0,1,0">
                <Grid Margin="34,30,32,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Border Width="72" Height="72" CornerRadius="10" Background="#326FE6"
                                BorderBrush="#568AF0" BorderThickness="1" HorizontalAlignment="Left">
                            <Image Source="Assets/logo.png" Width="54" Height="54" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="ZFTP" FontSize="32" FontWeight="SemiBold" Margin="0,18,0,2" />
                        <TextBlock Text="DESKTOP STORAGE MOUNTS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#6F8DB8" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Mount everything." FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Keep it local." FontSize="22" FontWeight="SemiBold" Foreground="#78A7FF" Margin="0,0,0,22" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="4" Background="#1B2940" BorderBrush="#2C4770" BorderThickness="1"><TextBlock Text="✓" FontSize="12" Foreground="#78A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Grid.Column="1" Text="11 storage providers" Foreground="#C7D4E4" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="4" Background="#1B2940" BorderBrush="#2C4770" BorderThickness="1"><TextBlock Text="✓" FontSize="12" Foreground="#78A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Grid.Column="1" Text="Encrypted local profiles" Foreground="#C7D4E4" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="4" Background="#1B2940" BorderBrush="#2C4770" BorderThickness="1"><TextBlock Text="✓" FontSize="12" Foreground="#78A7FF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Grid.Column="1" Text="Zero subscriptions" Foreground="#C7D4E4" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#171E28" BorderBrush="#2C3644" BorderThickness="1" CornerRadius="5" Padding="12,9" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" CornerRadius="1" Background="#62E6A7" Margin="0,0,8,0" />
                            <TextBlock x:Name="VersionBadgeText" Text="ZFTP · Windows x64" FontSize="11" Foreground="#B7C7DA" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#10141B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border VerticalAlignment="Bottom" Height="1" Background="#232A34" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,10,0">
                        <Button Style="{StaticResource GhostButton}" Width="36" Height="32" Padding="0" Margin="0,0,6,0" Click="Minimize_Click" Content="—" />
                        <Button x:Name="CloseTopButton" Style="{StaticResource GhostButton}" Width="36" Height="32" Padding="0" Click="Close_Click" Content="×" FontSize="18" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="48,26,48,42">
                    <!-- Welcome / options -->
                    <Grid x:Name="WelcomePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Install ZFTP" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="Fast, local, and predictable. Setup only adds the components ZFTP actually needs."
                                       Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,28,0,0">
                            <TextBlock Text="INSTALL LOCATION" FontSize="10" FontWeight="SemiBold" Foreground="#718198" Margin="2,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="#12171F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="46">
                                    <TextBox x:Name="InstallPathBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                             FontSize="13" VerticalContentAlignment="Center" Padding="14,0" CaretBrush="White" />
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="14,8" Content="Browse" Click="Browse_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,22,0,0">
                            <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="SemiBold" Foreground="#718198" Margin="2,0,0,8" />
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16,14" Margin="0,0,0,9">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Desktop shortcut" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Put ZFTP one click away." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="DesktopShortcutCheck" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Keep your mounted drives ready in the tray." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                                    <CheckBox x:Name="StartupCheck" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                                <Border x:Name="DotNetBadge" CornerRadius="4" Padding="10,5" Background="#151D28" BorderBrush="#2B394D" BorderThickness="1" Margin="0,0,8,0"><TextBlock x:Name="DotNetBadgeText" Text=".NET 8 · checking" FontSize="10" Foreground="#AAB8C9" /></Border>
                                <Border x:Name="WinFspBadge" CornerRadius="4" Padding="10,5" Background="#151D28" BorderBrush="#2B394D" BorderThickness="1"><TextBlock x:Name="WinFspBadgeText" Text="WinFsp · checking" FontSize="10" Foreground="#AAB8C9" /></Border>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,24,0,0">
                            <TextBlock x:Name="SpaceText" Text="About 210 MB installed" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Content="Install ZFTP  →" Click="Install_Click" />
                        </Grid>
                    </Grid>

                    <!-- Progress -->
                    <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="12" Background="#162237" BorderBrush="#2C4770" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,22">
                                <Grid>
                                    <Ellipse Width="38" Height="38" Stroke="#2D7DD2" StrokeThickness="3" Opacity="0.35" />
                                    <TextBlock Text="↓" FontSize="27" Foreground="#7CBAFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Installing ZFTP" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ProgressStatusText" Text="Preparing your files…" Foreground="{StaticResource MutedBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,28" />
                            <Border Height="8" CornerRadius="2" Background="#1A2029">
                                <Grid ClipToBounds="True">
                                    <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="4" Height="8" BorderThickness="0" Foreground="#2D7DD2" Background="Transparent" />
                                </Grid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="ProgressDetailText" Text="Starting…" Foreground="#6F8197" FontSize="10" />
                                <TextBlock x:Name="ProgressPercentText" Text="4%" Foreground="#91A7C1" FontSize="10" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Completion -->
                    <Grid x:Name="DonePanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="410">
                            <Border Width="82" Height="82" CornerRadius="12" Background="#173126" BorderBrush="#29523E" BorderThickness="1" Margin="0,0,0,22">
                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                            </Border>
                            <TextBlock Text="You’re all set." FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DoneSubtitle" Text="ZFTP is installed and ready to mount your storage." Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,9,0,28" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="Close" Click="Close_Click" Margin="0,0,10,0" />
                                <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Content="Launch ZFTP  →" Click="Launch_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Error -->
                    <Grid x:Name="ErrorPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="430">
                            <Border Width="82" Height="82" CornerRadius="12" Background="#351C24" BorderBrush="#5A2B38" BorderThickness="1" Margin="0,0,0,22">
                                <TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="That didn’t finish." FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ErrorText" Text="Something interrupted setup." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,28" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="Close" Click="Close_Click" Margin="0,0,10,0" />
                                <Button Style="{StaticResource PrimaryButton}" Content="Try again" Click="Retry_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Uninstall -->
                    <Grid x:Name="UninstallPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="430">
                            <Border Width="82" Height="82" CornerRadius="12" Background="#171E29" BorderBrush="#303B4A" BorderThickness="1" Margin="0,0,0,22">
                                <Image Source="Assets/logo.png" Width="56" Height="56" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Remove ZFTP?" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Your saved connection profiles and themes stay on this PC. Only the application files, shortcuts, and startup entry are removed."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,28" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="Keep ZFTP" Click="Close_Click" Margin="0,0,10,0" />
                                <Button x:Name="UninstallButton" Style="{StaticResource PrimaryButton}" Content="Remove ZFTP" Click="Uninstall_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
